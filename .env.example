# Neon Postgres. Use the pooled connection string.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/kotonoha?sslmode=require

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client. Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The only address allowed to sign in.
ALLOWED_EMAIL=you@example.com

# Anthropic API key for /api/draft.
ANTHROPIC_API_KEY=
